package docs

import "m31labs.dev/gosx/route"

// featureCard has the same exported fields as FeatureCardProps in page.gsx.
// A strict component accepts a spread only from a struct, so the page loads
// structs here, not maps.
type featureCard struct {
	Kicker string
	Title  string
	Body   string
	Href   string
}

func init() {
	RegisterStaticDocsPage(
		"Overview",
		"A starter documentation site built with GoSX: file routes, nested layouts, validated forms, and auth.",
		route.FileModuleOptions{
			Load: func(ctx *route.RouteContext, page route.FilePage) (any, error) {
				return map[string]any{
					"showRouteTree": true,
					"features": []featureCard{
						{
							Kicker: "Routing",
							Title:  "Folders are routes.",
							Body:   "Each folder under app/ is a URL. Add a page.gsx for the page and a layout.gsx to wrap everything beneath it.",
							Href:   "/docs/routing",
						},
						{
							Kicker: "Forms",
							Title:  "Validated forms with no client code.",
							Body:   "A page.server.go Actions entry validates on the server and sends the user back with their values and any errors.",
							Href:   "/docs/forms",
						},
						{
							Kicker: "Auth",
							Title:  "Sessions and guarded pages.",
							Body:   "Signed sessions, CSRF protection, and a sign-in flow ride inside the same routed app.",
							Href:   "/docs/auth",
						},
						{
							Kicker: "Runtime",
							Title:  "Page changes without a full reload.",
							Body:   "Marked links fetch HTML and swap the page. Without JavaScript, they are ordinary links.",
							Href:   "/docs/runtime",
						},
						{
							Kicker: "Ship it",
							Title:  "One dist/ folder is the whole deployment.",
							Body:   "Run gosx build --prod, check the bundle with gosx deploy check dist, and follow the deployment guide.",
							Href:   "https://gosx.m31labs.dev/docs/deployment",
						},
					},
				}, nil
			},
		},
	)
}
