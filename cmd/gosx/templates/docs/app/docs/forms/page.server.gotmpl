package docs

import (
	"errors"
	"strings"

	docsapp "__MODULE__/app"
	"m31labs.dev/gosx/action"
	"m31labs.dev/gosx/route"
	"m31labs.dev/gosx/session"
)

func init() {
	docsapp.RegisterDocsPage(
		"Forms",
		"Managed POST actions, CSRF protection, validation, and session-backed flashes.",
		route.FileModuleOptions{},
	)
}

// RegisterManagedActions installs the form action on the application's
// route.Router before Build. The managed namespace is global and immutable
// after the router is built.
func RegisterManagedActions(router *route.Router) error {
	if router == nil {
		return errors.New("managed action router is nil")
	}
	return router.RegisterManagedPOST("subscribe", action.Config{}, func(ctx *action.Context) (action.Result, error) {
		if strings.TrimSpace(ctx.Form.Value("email")) == "" {
			return action.Result{}, action.Validation("Add an email address to continue.", map[string]string{"email": "Email is required."})
		}
		if err := session.AddFlash(ctx.Request, "notice", "The session flash survived the managed form post."); err != nil {
			return action.Result{}, err
		}
		return action.Result{OK: true, Redirect: "/docs/forms"}, nil
	})
}
