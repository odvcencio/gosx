+func TestCanonicalIRInstancedMaterialParity(t *testing.T) {
+	shaderLayout := map[string]any{"position": "vec3", "uv": "vec2"}
+	uniforms := map[string]any{"time": 0.5, "tint": [3]float64{0.2, 0.4, 0.8}}
+	sourceFiles := map[string]string{"vertex.glsl": "void main() {}"}
+	material := CustomMaterial{
+		StandardMaterial: StandardMaterial{
+			Color:        "#ff8800",
+			Texture:      "albedo.png",
+			Roughness:    0.25,
+			Metalness:    0.75,
+			Clearcoat:    0.5,
+			Sheen:        0.3,
+			Transmission: 0.1,
+			Iridescence:  0.2,
+			Anisotropy:   0.4,
+			NormalMap:    "normal.png",
+			RoughnessMap: "roughness.png",
+			MetalnessMap: "metalness.png",
+			OcclusionMap: "occlusion.png",
+			EmissiveMap:  "emissive.png",
+			Emissive:     0.15,
+			Opacity:      Float(0.9),
+			BlendMode:    BlendAlpha,
+			Wireframe:    Bool(true),
+		},
+		ShaderBackend:     "wgsl",
+		ShaderLayout:      shaderLayout,
+		ShaderSource:      "fn vs_main() -> void {}",
+		ShaderSourceFiles: sourceFiles,
+		VertexGLSL:        "void main() {}",
+		FragmentGLSL:      "void main() {}",
+		VertexWGSL:        "@vertex fn vs() {}",
+		FragmentWGSL:      "@fragment fn fs() {}",
+		Uniforms:          uniforms,
+	}
+	props := Props{
+		Graph: NewGraph(
+			Mesh{ID: "mesh", Geometry: BoxGeometry{SizeX: 1}, Material: material},
+			InstancedMesh{
+				ID:        "instanced",
+				Count:     1,
+				Geometry:  BoxGeometry{SizeX: 1},
+				Material:  material,
+				Positions: []Vector3{{X: 1, Y: 2, Z: 3}},
+			},
+		),
+	}
+
+	ir, err := props.CanonicalIR()
+	if err != nil {
+		t.Fatalf("CanonicalIR: %v", err)
+	}
+	if got := len(ir.Materials); got != 1 {
+		t.Fatalf("len(ir.Materials) = %d, want 1", got)
+	}
+	mat := ir.Materials[0]
+	if mat.Roughness != 0.25 || mat.Metalness != 0.75 || mat.Clearcoat != 0.5 || mat.Transmission != 0.1 {
+		t.Errorf("physical PBR fields not preserved: %+v", mat)
+	}
+	if mat.BlendMode != BlendAlpha {
+		t.Errorf("BlendMode = %q, want %q", mat.BlendMode, BlendAlpha)
+	}
+	if mat.Wireframe == nil || !*mat.Wireframe {
+		t.Errorf("Wireframe not preserved: %v", mat.Wireframe)
+	}
+	if mat.ShaderBackend != "wgsl" || mat.ShaderSource == "" || mat.VertexWGSL == "" || mat.FragmentGLSL == "" {
+		t.Errorf("custom shader envelope not preserved: %+v", mat)
+	}
+	if !reflect.DeepEqual(mat.Uniforms["time"], 0.5) || !reflect.DeepEqual(mat.ShaderLayout["position"], "vec3") ||
+		mat.ShaderSourceFiles["vertex.glsl"] != "void main() {}" {
+		t.Errorf("shader maps not preserved: uniforms=%v layout=%v files=%v", mat.Uniforms, mat.ShaderLayout, mat.ShaderSourceFiles)
+	}
+}
+
+func TestMaterialFromInstancedIRClonesShaderMaps(t *testing.T) {
+	src := &InstancedMeshIR{
+		ID:                "instanced-src",
+		CustomUniforms:    map[string]any{"time": 1.0},
+		ShaderLayout:      map[string]any{"normal": "vec3"},
+		ShaderSourceFiles: map[string]string{"frag.wgsl": "return vec4f(1);"},
+	}
+	mat := materialFromInstancedIR(src)
+	src.CustomUniforms["time"] = 2.0
+	src.ShaderLayout["normal"] = "vec4"
+	src.ShaderSourceFiles["frag.wgsl"] = "mutated"
+	if !reflect.DeepEqual(mat.Uniforms["time"], 1.0) {
+		t.Errorf("Uniforms aliased source map: %v", mat.Uniforms)
+	}
+	if !reflect.DeepEqual(mat.ShaderLayout["normal"], "vec3") {
+		t.Errorf("ShaderLayout aliased source map: %v", mat.ShaderLayout)
+	}
+	if !reflect.DeepEqual(mat.ShaderSourceFiles["frag.wgsl"], "return vec4f(1);") {
+		t.Errorf("ShaderSourceFiles aliased source map: %v", mat.ShaderSourceFiles)
+	}
+}