+// materialFromInstancedIR flattens the material carried by an InstancedMeshIR,
+// copying every field shared between InstancedMeshIR and IRMaterial so that
+// instanced nodes reach the canonical IR with parity against regular meshes.
+func materialFromInstancedIR(src *InstancedMeshIR) *IRMaterial {
+	material := &IRMaterial{
+		ID:           src.ID,
+		Color:        src.Color,
+		Texture:      src.Texture,
+		Roughness:    src.Roughness,
+		Metalness:    src.Metalness,
+		Clearcoat:    src.Clearcoat,
+		Sheen:        src.Sheen,
+		Transmission: src.Transmission,
+		Iridescence:  src.Iridescence,
+		Anisotropy:   src.Anisotropy,
+		NormalMap:    src.NormalMap,
+		EmissiveMap:  src.EmissiveMap,
+		Emissive:     src.Emissive,
+		BlendMode:    src.BlendMode,
+		Wireframe:    src.Wireframe,
+		RenderOrder:  src.RenderOrder,
+		CastShadow:   src.CastShadow,
+		DoubleSided:  src.DoubleSided,
+		ShaderBackend: src.ShaderBackend,
+		ShaderSource:  src.ShaderSource,
+		VertexGLSL:    src.VertexGLSL,
+		FragmentGLSL:  src.FragmentGLSL,
+		VertexWGSL:    src.VertexWGSL,
+		FragmentWGSL:  src.FragmentWGSL,
+	}
+	if src.Opacity != nil {
+		opacity := *src.Opacity
+		material.Opacity = &opacity
+	}
+	if len(src.CustomUniforms) > 0 {
+		material.Uniforms = cloneAnyMap(src.CustomUniforms)
+	}
+	if len(src.ShaderLayout) > 0 {
+		material.ShaderLayout = cloneAnyMap(src.ShaderLayout)
+	}
+	if len(src.ShaderSourceFiles) > 0 {
+		material.ShaderSourceFiles = cloneStringMap(src.ShaderSourceFiles)
+	}
+	return material
 }
+
+func cloneAnyMap(src map[string]any) map[string]any {
+	out := make(map[string]any, len(src))
+	for k, v := range src {
+		out[k] = v
+	}
+	return out
+}
+
+func cloneStringMap(src map[string]string) map[string]string {
+	out := make(map[string]string, len(src))
+	for k, v := range src {
+		out[k] = v
+	}
+	return out
+}
