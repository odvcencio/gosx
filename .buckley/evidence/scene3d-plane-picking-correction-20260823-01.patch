+func TestPlaneRaycastMatchesRenderedXZSurface(t *testing.T) {
+	graph := NewGraph(Decal{ID: "ground", Width: 4, Height: 4})
+	hit, ok := RaycastGraph(graph, Ray{Origin: Vec3(0, 3, 0), Direction: Vec3(0, -1, 0)})
+	if !ok {
+		t.Fatal("expected downward hit")
+	}
+	if math.Abs(hit.Distance-3) > 1e-9 || math.Abs(hit.Point.Y) > 1e-9 {
+		t.Fatalf("unexpected downward hit, got %#v", hit)
+	}
+	if math.Abs(hit.Normal.Y-1) > 1e-9 {
+		t.Fatalf("expected face-forward +Y normal, got %#v", hit.Normal)
+	}
+	hit, ok = RaycastGraph(graph, Ray{Origin: Vec3(0, -2, 0), Direction: Vec3(0, 1, 0)})
+	if !ok {
+		t.Fatal("expected upward hit")
+	}
+	if math.Abs(hit.Distance-2) > 1e-9 || math.Abs(hit.Point.Y) > 1e-9 {
+		t.Fatalf("unexpected upward hit, got %#v", hit)
+	}
+	if math.Abs(hit.Normal.Y+1) > 1e-9 {
+		t.Fatalf("expected face-forward -Y normal, got %#v", hit.Normal)
+	}
+	if _, ok := RaycastGraph(graph, Ray{Origin: Vec3(0, 0, 0), Direction: Vec3(0, 1, 0)}); ok {
+		t.Fatal("a coplanar parallel ray must miss")
+	}
+	if _, ok := RaycastGraph(graph, Ray{Origin: Vec3(3, 1, 0), Direction: Vec3(0, -1, 0)}); ok {
+		t.Fatal("a ray outside the width bound on X must miss")
+	}
+	if _, ok := RaycastGraph(graph, Ray{Origin: Vec3(0, 1, 3), Direction: Vec3(0, -1, 0)}); ok {
+		t.Fatal("a ray outside the height bound on Z must miss")
+	}
+}
 
