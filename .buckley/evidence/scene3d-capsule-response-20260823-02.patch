+// intersectCapsule picks a finite Y-axis capsule analytically: it tests the
+// cylindrical body and both spherical caps, then keeps the nearest non-negative
+// hit with the correct outward normal.
+func intersectCapsule(ray Ray, radius, halfH float64) (RayHit, bool) {
+	best := RayHit{}
+	found := false
+	consider := func(hit RayHit, ok bool) {
+		if !ok || hit.Distance < 0 {
+			return
+		}
+		if !found || hit.Distance < best.Distance {
+			best, found = hit, true
+		}
+	}
+	consider(intersectSphereCentered(ray, Vector3{}, radius))
+	consider(intersectSphereCentered(ray, Vector3{Y: halfH}, radius))
+	consider(intersectSphereCentered(ray, Vector3{Y: -halfH}, radius))
+	body := rayBody(ray, radius, halfH)
+	consider(body.hit, body.ok)
+	return best, found
+}
+
+func intersectSphereCentered(ray Ray, center Vector3, radius float64) (RayHit, bool) {
+	oc := subVectors(ray.Origin, center)
+	b := dotVector(oc, ray.Direction)
+	c := dotVector(oc, oc) - radius*radius
+	discriminant := b*b - c
+	if discriminant < 0 {
+		return RayHit{}, false
+	}
+	root := math.Sqrt(discriminant)
+	t := -b - root
+	if t < 0 {
+		t = -b + root
+	}
+	if t < 0 {
+		return RayHit{}, false
+	}
+	point := addVectors(ray.Origin, scaleVector(ray.Direction, t))
+	return RayHit{Distance: t, Point: point, Normal: normalizeVector(subVectors(point, center))}, true
+}
+
+func rayBody(ray Ray, radius, halfH float64) (hit RayHit, ok bool) {
+	const epsilon = 1e-9
+	dx, dy, dz := ray.Direction.X, ray.Direction.Y, ray.Direction.Z
+	ox, oy, oz := ray.Origin.X, ray.Origin.Y-halfH, ray.Origin.Z
+	a := dx*dx + dz*dz
+	b := ox*dx + oz*dz
+	c := ox*ox + oz*oz - radius*radius
+	if a < epsilon {
+		return RayHit{}, false
+	}
+	discriminant := b*b - a*c
+	if discriminant < 0 {
+		return RayHit{}, false
+	}
+	root := math.Sqrt(discriminant)
+	t := (-b - root) / a
+	if t < 0 {
+		t = (-b + root) / a
+	}
+	if t < 0 {
+		return RayHit{}, false
+	}
+	point := addVectors(ray.Origin, scaleVector(ray.Direction, t))
+	if point.Y < -halfH || point.Y > halfH {
+		return RayHit{}, false
+	}
+	normal := normalizeVector(Vector3{X: point.X, Y: 0, Z: point.Z})
+	return RayHit{Distance: t, Point: point, Normal: normal}, true
+}
