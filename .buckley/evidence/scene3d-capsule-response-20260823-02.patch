diff --git a/client/js/bootstrap-src/harness-tests.ts b/client/js/bootstrap-src/harness-tests.ts
index 0000010..0000011 100644
--- a/client/js/bootstrap-src/harness-tests.ts
+++ b/client/js/bootstrap-src/harness-tests.ts
@@ -0,0 +1,60 @@
+function runCapsuleHarnessTests() {
+  const defaults = { kind: "capsule", radius: 1, height: 1, segments: 4, radialSegments: 8 };
+  const mesh = generateInstancedCapsuleGeometry(defaults.radius, defaults.height, defaults.segments, defaults.radialSegments);
+  if (!(mesh.positions instanceof Float32Array)) throw new Error("positions not typed");
+  if (!mesh.vertexCount) throw new Error("empty vertex count");
+  let minY = Infinity, maxY = -Infinity, maxRadial = 0;
+  for (let i = 0; i + 2 < mesh.positions.length; i += 3) {
+    const x = mesh.positions[i], y = mesh.positions[i + 1], z = mesh.positions[i + 2];
+    if (!Number.isFinite(x) || !Number.isFinite(y) || !Number.isFinite(z)) throw new Error("non-finite");
+    minY = Math.min(minY, y); maxY = Math.max(maxY, y);
+    maxRadial = Math.max(maxRadial, Math.hypot(x, z));
+  }
+  const total = defaults.height / 2 + defaults.radius;
+  if (Math.abs(minY + total) > 1e-6 || Math.abs(maxY - total) > 1e-6) throw new Error("Y bounds");
+  if (maxRadial > defaults.radius + 1e-6) throw new Error("radial bound");
+  for (let i = 0; i + 2 < mesh.normals.length; i += 3) {
+    const l = mesh.normals[i] ** 2 + mesh.normals[i + 1] ** 2 + mesh.normals[i + 2] ** 2;
+    if (Math.abs(l - 1) > 1e-5) throw new Error("unit normals");
+  }
+  const clampedHigh = generateInstancedCapsuleGeometry(1, 1, 999, 999);
+  if (clampedHigh.vertexCount !== generateInstancedCapsuleGeometry(1, 1, 64, 256).vertexCount) throw new Error("high clamps");
+  const clampedLow = generateInstancedCapsuleGeometry(1, 1, 0, 1);
+  if (clampedLow.vertexCount !== generateInstancedCapsuleGeometry(1, 1, 1, 3).vertexCount) throw new Error("low clamps");
+  const instanced = sceneInstancedTriangleMesh("capsule", defaults);
+  if (!instanced || !(instanced.count > 2)) throw new Error("ordinary/instanced routing failed");
+  const ordinary = scenePrimitiveTriangleMesh(defaults);
+  if (!ordinary || !(ordinary.count > 2)) throw new Error("ordinary routing failed");
+}
+runCapsuleHarnessTests();
diff --git a/client/js/bootstrap-src/16c-capsule-generator.ts b/client/js/bootstrap-src/16c-capsule-generator.ts
new file mode 100644
index 0000000..0000012
--- /dev/null
+++ b/client/js/bootstrap-src/16c-capsule-generator.ts
@@ -0,0 +1,78 @@
+// Shared in-IIFE capsule generator for the browser runtime. Defaults and
+// clamps match the Go generator exactly: radius 1, height 1, segments 1..64,
+// radialSegments 3..256.
+function generateInstancedCapsuleGeometry(radius, height, segments, radialSegments) {
+  var r = instancedPositiveNumber(radius, 1);
+  var h = instancedPositiveNumber(height, 1);
+  var seg = instancedSegmentCount(segments, 4, 1, 64);
+  var rad = instancedSegmentCount(radialSegments, 8, 3, 256);
+  var halfH = h * 0.5;
+  var rows = seg * 2 + 2;
+  var writer = createInstancedGeometryWriter((rows - 1) * rad * 2 * 3);
+  for (var row = 0; row < rows; row++) {
+    var theta, cosT, sinT, y;
+    if (row <= seg) {
+      theta = (Math.PI / 2) * row / seg;
+      cosT = Math.cos(theta);
+      sinT = Math.sin(theta);
+      y = halfH + r * cosT;
+    } else {
+      theta = (Math.PI / 2) * (row - seg) / seg;
+      cosT = -Math.cos(theta);
+      sinT = Math.sin(theta);
+      y = -halfH - r * cosT;
+    }
+    var sinRow = Math.sqrt(Math.max(0, 1 - cosT * cosT));
+    var v = row / (rows - 1);
+    for (var lon = 0; lon <= rad; lon++) {
+      var phi = (Math.PI * 2 * lon) / rad;
+      var c = Math.cos(phi);
+      var s = Math.sin(phi);
+      var normal = [c * sinRow, cosT, s * sinRow];
+      var position = [r * c * sinRow, y, r * s * sinRow];
+      writer.push(position, normal, [lon / rad, v], [c, 0, s, 1]);
+    }
+  }
+  for (var rowA = 0; rowA < rows - 1; rowA++) {
+    for (var lonA = 0; lonA < rad; lonA++) {
+      var idx = rowA * rad + lonA;
+      var a = idx, b2 = idx + 1, d = idx + rad + 2, e = idx + rad + 1;
+      pushQuad(writer, a, b2, d, e);
+    }
  }
+  return writer.build();
+}
