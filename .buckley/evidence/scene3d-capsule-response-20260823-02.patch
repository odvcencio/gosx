index 0000000..000000a
--- /dev/null
+++ b/scene/geom/capsule.go
@@ -0,0 +1,96 @@
+package geom
+
+import "math"
+
+// buildCapsule produces a smooth Y-axis capsule: a cylindrical middle joined
+// continuously to upper and lower hemispheres. The mesh is closed, non-indexed
+// and outward-facing; the normals are analytic outward directions. UVs use
+// longitude around XZ and a monotonic latitude/body V.
+func buildCapsule(radius, height float64, segments, radialSegments int, want Attribute) *Mesh {
+	if radius <= 0 {
+		radius = 1
+	}
+	if height <= 0 {
+		height = 1
+	}
+	if segments < 1 {
+		segments = 1
+	}
+	if segments > 64 {
+		segments = 64
+	}
+	if radialSegments < 3 {
+		radialSegments = 3
+	}
+	if radialSegments > 256 {
+		radialSegments = 256
+	}
+	halfH := height / 2
+	sideColor := vec3{0.62, 0.75, 0.95}
+	rows := make([][]vertex, 2*segments+2)
+	for row := 0; row <= 2*segments+1; row++ {
+		var y, sinT, cosT float64
+		if row <= segments {
+			theta := math.Pi / 2 * float64(row)/float64(segments)
+			sinT, cosT = math.Cos(theta), math.Sin(theta)
+			y = halfH + radius*cosT
+		} else {
+			theta := math.Pi / 2 * float64(row-segments)/float64(segments)
+			sinT, cosT = math.Sin(theta), -math.Cos(theta)
+			y = -halfH - radius*cosT
+		}
+		v := float64(row) / float64(2*segments)
+		line := make([]vertex, radialSegments+1)
+		for lon := 0; lon <= radialSegments; lon++ {
+			phi := float64(lon) * 2 * math.Pi / float64(radialSegments)
+			c, s := math.Cos(phi), math.Sin(phi)
+			normal := vec3{c * sinT, cosT, s * sinT}
+			line[lon] = vertex{
+				position: vec3{radius * c * sinT, y, radius * s * sinT},
+				normal:   normal,
+				uv:       vec2{U: float64(lon) / float64(radialSegments), V: v},
+				color:    vec3{X: 0.62, Y: 0.75, Z: 0.95},
+			}
+		}
+		rows[row] = line
+	}
+	b := newBuilder(want, capsuleTriangleCount(segments, radialSegments)*3)
+	for row := 0; row < len(rows)-1; row++ {
+		for lon := 0; lon < radialSegments; lon++ {
+			a := rows[row][lon]
+			c := rows[row][lon+1]
+			d := rows[row+1][lon+1]
+			e := rows[row+1][lon]
+			b.tri(a, c, d)
+			b.tri(a, d, e)
+		}
+	}
+	return b.build()
+}
+
+func capsuleRows(segments int) int { return 2*segments + 2 }
+
+func capsuleTriangleCount(segments, radialSegments int) int {
+	return (capsuleRows(segments) - 1) * radialSegments * 2
+}
+
+func capsuleVertexCount(segments, radialSegments int) int {
+	return capsuleTriangleCount(segments, radialSegments) * 3
+}
+
