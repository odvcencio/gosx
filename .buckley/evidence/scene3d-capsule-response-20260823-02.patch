+package geom
+
+import "testing"
+
+func TestCapsuleDrawVertexCountMatchesBuild(t *testing.T) {
+	params := Normalize(Params{Kind: KindCapsule})
+	if DrawVertexCount(params) != VertexCount(params) {
+		t.Fatal("capsule is non-indexed; draw and vertex counts must agree")
+	}
+}
+
+func TestCapsuleAttributesRespected(t *testing.T) {
+	onlyPositions := Build(Params{Kind: KindCapsule}, AttributePositions)
+	if onlyPositions == nil || len(onlyPositions.Positions) == 0 {
+		t.Fatal("positions missing")
+	}
+	full := Build(Params{Kind: KindCapsule}, AttributesAll)
+	if full == nil || len(full.Normals) == 0 || len(full.UVs) == 0 || len(full.Colors) == 0 {
+		t.Fatal("streams missing under AttributesAll")
+	}
+}
+
+func TestCapsuleUnknownAttributeSafety(t *testing.T) {
+	if Build(Params{Kind: KindCapsule}, Attribute(255)) != nil {
+		t.Fatal("unknown attribute must yield no mesh")
+	}
+}
