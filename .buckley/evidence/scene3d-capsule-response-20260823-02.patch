@@ -0,0 +1,120 @@
+package geom
+
+import (
+	"math"
+	"testing"
+)
+
+func TestCapsuleNormalizeDefaultsAndClamps(t *testing.T) {
+	p := Normalize(Params{Kind: KindCapsule})
+	if p.Radius != 1 || p.Height != 1 || p.Segments != 4 || p.RadialSegments != 8 {
+		t.Fatalf("unexpected defaults %#v", p)
+	}
+	p = Normalize(Params{Kind: KindCapsule, Segments: 9999, RadialSegments: 9999})
+	if p.Segments != 64 || p.RadialSegments != 256 {
+		t.Fatalf("clamps failed %#v", p)
+	}
+	p = Normalize(Params{Kind: KindCapsule, Segments: 0, RadialSegments: 1})
+	if p.Segments != 1 || p.RadialSegments != 3 {
+		t.Fatalf("low clamps failed %#v", p)
+	}
+}
+
+func TestCapsuleCanonicalAlias(t *testing.T) {
+	if got := NormalizeKind("capsuleGeometry"); got != KindCapsule {
+		t.Fatalf("alias failed: %q", got)
+	}
+	if got := NormalizeKind("Capsule"); got != KindCapsule {
+		t.Fatalf("canonical failed: %q", got)
+	}
+}
+
+func TestCapsuleCacheKeySeparation(t *testing.T) {
+	a := CacheKey(Params{Kind: KindCapsule, Radius: 1, Height: 1, Segments: 4, RadialSegments: 8})
+	b := CacheKey(Params{Kind: KindCapsule, Radius: 2})
+	if a == b {
+		t.Fatal("cache keys must differ")
+	}
+	if CacheKey(Params{Kind: "capsulegeometry"}) == "" {
+		t.Fatal("alias cache key empty")
+	}
+}
+
+func TestCapsuleMeshConsistency(t *testing.T) {
+	m := Build(Normalize(Params{Kind: KindCapsule}), AttributesAll)
+	if m == nil {
+		t.Fatal("nil mesh")
+	}
+	if got := VertexCount(Normalize(Params{Kind: KindCapsule})); got != m.VertexCount() {
+		t.Fatalf("vertex count mismatch: %d vs %d", got, m.VertexCount())
+	}
+	for _, value := range append([]float64(nil), m.Positions...) {
+		if math.IsNaN(value) || math.IsInf(value, 0) {
+			t.Fatal("non-finite position")
+		}
+	}
+}
+
+func TestCapsuleBoundsAndNormals(t *testing.T) {
+	const radius, height = 1, 2
+	m := Build(Normalize(Params{Kind: KindCapsule, Radius: radius, Height: height}), AttributesAll)
+	minY, maxY := math.Inf(1), math.Inf(-1)
+	maxRadial := 0.0
+	for i := 0; i+2 < len(m.Positions); i += 3 {
+		y := m.Positions[i+1]
+		r := math.Hypot(m.Positions[i], m.Positions[i+2])
+		if y < minY {
+			minY = y
+		}
+		if y > maxY {
+			maxY = y
+		}
+		if r > maxRadial {
+			maxRadial = r
+		}
+	}
+	total := height/2 + radius
+	if math.Abs(minY+total) > 1e-9 || math.Abs(maxY-total) > 1e-9 {
+		t.Fatalf("Y bounds wrong: %v %v", minY, maxY)
+	}
+	if maxRadial > radius+1e-9 {
+		t.Fatalf("radial bound exceeded: %v", maxRadial)
+	}
+	for i := 0; i+2 < len(m.Normals); i += 3 {
+		nx, ny, nz := m.Normals[i], m.Normals[i+1], m.Normals[i+2]
+		length := nx*nx + ny*ny + nz*nz
+		if math.Abs(length-1) > 1e-9 {
+			t.Fatalf("normal not unit: %v", length)
+		}
+	}
+	assertWindingMatchesNormals(t, "capsule", m, 0)
+}
+
+func TestCapsuleBoundingRadius(t *testing.T) {
+	got := BoundingRadius(Params{Kind: KindCapsule, Radius: 1, Height: 2})
+	want := math.Hypot(1, 2)
+	if math.Abs(got-want) > 1e-12 {
+		t.Fatalf("bounding radius %v, want %v", got, want)
+	}
+}
