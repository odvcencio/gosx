# Compiled test binaries from 'go test -c'. Agents and benchmark runs leave
# these at the repository root; one reached 8.2 MB.
*.test
*.test.exe

# Cross-compiled CLI binaries. The Windows build gate leaves gosx.exe at the
# repository root; it is 36 MB, and *.test.exe above does not match it.
# Anchored with a leading slash: an unanchored "gosx" would also ignore the
# cmd/gosx source directory.
/gosx
/gosx.exe

# Compiled binary from 'go build ./examples/ouroboros-corpus' run at the
# repository root. Anchored with a leading slash to keep the source
# directory examples/ouroboros-corpus/ tracked.
/ouroboros-corpus
