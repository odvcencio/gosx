/dashboard
build/
.canopy/
/docs/*
!/docs/docs-site-operations.md
!/docs/docs-site-spec.md
!/docs/polar.md
!/docs/scene3d-v1-support.md
!/docs/stripe.md
/gosx
node_modules/

# Local dev data (SQLite, uploads) — never commit
data/

# Specs and plans — never commit
.claude/
docs/blog-outlines/
docs/specs/
docs/superpowers/

# Local dev workspace overlay (links sibling prism/selena checkouts) — never commit
go.work
go.work.sum

# Compiled test binaries from 'go test -c'. Agents and benchmark runs leave
# these at the repository root; one reached 8.2 MB.
*.test
*.test.exe

# Cross-compiled CLI binaries. The Windows build gate leaves gosx.exe at the
# repository root; it is 36 MB, and *.test.exe above does not match it.
# Anchored with a leading slash: an unanchored "gosx" would also ignore the
# cmd/gosx source directory.
/gosx
/gosx.exe
/gosx-docs
/gosx-docs.exe

# Compiled bootstrap helper. Build it from cmd/buildbootstrap when needed; do
# not track the local binary.
/cmd/buildbootstrap/buildbootstrap
/cmd/buildbootstrap/buildbootstrap.exe

# Compiled binary from 'go build ./examples/ouroboros-corpus' run at the
# repository root. Anchored with a leading slash to keep the source
# directory examples/ouroboros-corpus/ tracked.
/ouroboros-corpus

# Local scratch and verification artifacts belong outside the repository index.
/tmp/
