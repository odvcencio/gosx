scene.CustomPost{
	Name:     "Glass",
	Material: glassMaterial,
	DOMRegions: scene.CustomPostDOMRegions{
		Selector:      ".hero-card",
		Max:           1,
		PresenceClass: "hero-glass-live",
	},
}

