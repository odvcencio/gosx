program := motion.NewProgram("gallery")

scroll := program.ScrollProgress("scroll", "", motion.AxisY)
// A camera rail moves the camera along a spline while it keeps looking at the
// look-at point. Scroll progress picks the position on the rail.
_ = program.CameraRail("rail", scroll, "#scene", []motion.RailStop{
	{At: 0, Position: [3]float64{0, 0, 6}, LookAt: [3]float64{0, 0, 0}, FOV: 60},
	{At: 1, Position: [3]float64{2.5, 1, 4.5}, LookAt: [3]float64{0, 0, 0}, FOV: 50},
})

hover := program.Hover("hover", "#grow-button")
spring := program.Spring("grow", 0, motion.SpringOptions{
	Input:   hover,
	Physics: motion.Spring{Stiffness: 280, Damping: 23},
})
scale := program.Map("scale", spring, 0, 1, 1, 1.4)
program.BindSceneNode(scale, "#scene", "sphere", "scale.x")
program.BindSceneNode(scale, "#scene", "sphere", "scale.y")
program.BindSceneNode(scale, "#scene", "sphere", "scale.z")
program.PinTo("#scene", "marker-node", "#html-marker")

node := ctx.MotionScope(program, gosx.El("section",
	gosx.El("button", gosx.Attr("id", "grow-button"), gosx.Text("Grow")),
	gosx.El("div", gosx.Attr("id", "html-marker")),
))
