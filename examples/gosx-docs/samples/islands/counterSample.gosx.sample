package counter

//gosx:island
component Counter() {
	count := signal.New(0)
	increment := func() { count.Set(count.Get() + 1) }
	decrement := func() { count.Set(count.Get() - 1) }
	return <div class="counter">
		<button onClick={decrement}>-</button>
		<span>{count.Get()}</span>
		<button onClick={increment}>+</button>
	</div>
}