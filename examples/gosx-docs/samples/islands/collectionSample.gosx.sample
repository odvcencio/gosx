package app

import (
	"m31labs.dev/gosx/browser"
	"m31labs.dev/gosx/signal"
)

type CollectionProps struct { Initial []string }

//gosx:island
component Collection(props: CollectionProps) {
	items := signal.New(props.Initial)
	draft := signal.New("")
	edit := func() { draft.Set(value) }
	focusDraft := func() { browser.Focus("#collection-draft") }
	add := func() {
		browser.PreventDefault()
		if draft.Get() == "" || len(items.Get()) >= 12 {
			return
		}
		items.Set(append(items.Get(), draft.Get()))
		draft.Set("")
		focusDraft()
	}
	clear := func() { items.Set([]string{}); focusDraft() }
	return <section>
		<form onSubmit={add}>
			<input id="collection-draft" aria-label="New item" value={draft.Get()} onInput={edit} required maxlength="48" />
			<button type="submit" disabled={draft.Get() == "" || len(items.Get()) >= 12}>Add</button>
			<button type="button" onClick={clear}>Clear</button>
		</form>
		<ul aria-live="polite">
			<Each of={items.Get()} as="item"><li>{item}</li></Each>
		</ul>
	</section>
}
