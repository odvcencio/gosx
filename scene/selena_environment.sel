fn gsxEnvironmentDirection(direction: vec3, rotation: float) -> vec3 {
    let d = normalize(direction)
    let c = cos(rotation)
    let s = sin(rotation)
    return vec3f(d.x * c + d.z * s, d.y, -d.x * s + d.z * c)
}
fn gsxEnvironmentReflection(radiance: textureCube, info: vec4, direction: vec3, roughness: float, fallback: vec3) -> vec3 {
    let d = gsxEnvironmentDirection(direction, info.z)
    let sampleColor = sampleCubeLevel(radiance, d, clamp(roughness, 0.0, 1.0) * max(info.w, 0.0)).rgb
    return mix(fallback, sampleColor * max(info.y, 0.0), clamp(info.x, 0.0, 1.0))
}
fn gsxEnvironmentDiffuse(irradiance: textureCube, info: vec4, normal: vec3, fallback: vec3) -> vec3 {
    let d = gsxEnvironmentDirection(normal, info.z)
    let sampleColor = sampleCubeLevel(irradiance, d, 0.0).rgb
    return mix(fallback, sampleColor * max(info.y, 0.0), clamp(info.x, 0.0, 1.0))
}
fn gsxEnvironmentSpecular(radiance: textureCube, brdfLUT: texture2d, info: vec4, direction: vec3, roughness: float, normalDotView: float, f0: vec3, f90: float, fallback: vec3) -> vec3 {
    let prefiltered = gsxEnvironmentReflection(radiance, info, direction, roughness, fallback)
    let brdf = sampleLevel(brdfLUT, vec2f(clamp(normalDotView, 0.0, 1.0), clamp(roughness, 0.0, 1.0)), 0.0).rg
    return prefiltered * mix(f0, f0 * brdf.x + vec3f(f90, f90, f90) * brdf.y, clamp(info.x, 0.0, 1.0))
}
