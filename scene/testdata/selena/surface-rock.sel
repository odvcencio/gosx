// A surface-kind material: it returns a Surface record and the renderer's
// standard lighting shades it.
material SurfaceRock {
    param albedo : texture2d
    param tint : color = rgb(0.9, 0.85, 0.8)
    param roughness : float = 0.8

    surface(geo) -> Surface {
        let c = sample(albedo, geo.uv).rgb * tint
        return withOcclusion(pbr(c, roughness, 0.0), 0.9)
    }
}
