{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gosx/perf/v2.schema.json",
  "oneOf": [{"$ref": "#/$defs/Profile"}, {"$ref": "#/$defs/Coefficients"}, {"$ref": "#/$defs/Toolchain"}],
  "$defs": {
    "ID": {"type":"string","pattern":"^[a-z][a-z0-9-]{0,47}$"},
    "SHA": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "Path": {"type":"string","pattern":"^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$","maxLength":240},
    "Scenario": {"enum":["hard-cold","hard-warm","soft","bfcache","desktop"]},
    "Count": {"type":"integer","minimum":0,"maximum":1000000},
    "Ref": {"type":"object","additionalProperties":false,"required":["file","sha256"],"properties":{"file":{"$ref":"#/$defs/Path"},"sha256":{"$ref":"#/$defs/SHA"}}},
    "Network": {"type":"object","additionalProperties":false,"required":["rttMicros","downBytesPerSec","upBytesPerSec"],"properties":{"rttMicros":{"type":"integer","minimum":0,"maximum":10000000},"downBytesPerSec":{"type":"integer","minimum":1},"upBytesPerSec":{"type":"integer","minimum":1}}},
    "Profile": {"type":"object","additionalProperties":false,"required":["schema","id","version","reference","width","height","dprMilli","cpuMultiplierMilli","networks","setupRtts","firstByteRtts","initCwndBytes","quantumBytes"],"properties":{"schema":{"const":"gosx.budget-profile/v1"},"id":{"$ref":"#/$defs/ID"},"version":{"type":"integer","minimum":1},"reference":{"enum":["desktop-cpu-proxy","phone-4gb"]},"width":{"const":412},"height":{"const":823},"dprMilli":{"const":1750},"cpuMultiplierMilli":{"type":"integer","minimum":1000,"maximum":8000},"benchmarkIndexTarget":{"type":"integer","minimum":1},"networks":{"type":"object","additionalProperties":false,"required":["slow4g","p75"],"properties":{"slow4g":{"$ref":"#/$defs/Network"},"p75":{"$ref":"#/$defs/Network"}}},"setupRtts":{"type":"integer","minimum":0,"maximum":4},"firstByteRtts":{"type":"integer","minimum":0,"maximum":2},"initCwndBytes":{"const":14600},"quantumBytes":{"const":1024}}},
    "Coefficient": {"type":"object","additionalProperties":false,"required":["name","value","ci95","status","nVisits","nBlocks","method"],"properties":{"name":{"enum":["serverMicros","renderMicros","jsMicrosPerKB","wasmCompileMicrosPerRawKB","wasmOverlapPPM","wasmInstantiateMicros","programDecodeMicrosPerKB","engineStartMicros","pipelineCreateMicros","shaderCompileMicrosPerKB","hydrationMicrosPerIsland"]},"value":{"type":["integer","null"],"minimum":0},"ci95":{"type":"array","minItems":2,"maxItems":2,"items":{"type":["integer","null"],"minimum":0}},"status":{"enum":["unknown","provisional","pilot","measured","unused"]},"nVisits":{"$ref":"#/$defs/Count"},"nBlocks":{"$ref":"#/$defs/Count"},"method":{"enum":["prior","stage-union-bound","isolated-fit","stage-completion","field-service","unused"]}}},
    "Coefficients": {"type":"object","additionalProperties":false,"required":["schema","profileSHA256","reference","measuredAt","sets"],"properties":{"schema":{"const":"gosx.budget-coefficients/v1"},"profileSHA256":{"$ref":"#/$defs/SHA"},"reference":{"enum":["desktop-cpu-proxy","phone-4gb"]},"measuredAt":{"type":"string","format":"date-time"},"sets":{"type":"array","minItems":1,"maxItems":32,"items":{"$ref":"#/$defs/CoefficientSet"}}}},
    "Toolchain": {"type":"object","additionalProperties":false,"required":["schema","go","tinygo","llvm","binaryen","binaryenSHA256","brotli","brotliQuality","brotliWindow","gzipLevel","zopfli","zopfliIterations","builderBrotli","esbuild","chromeSnapshot","chromeProduct","platformArchives","fonts","cdproto","chromedp","node"],"properties":{"schema":{"const":"gosx.perf-toolchain/v1"},"go":{"const":"1.26.0"},"tinygo":{"const":"0.41.1"},"llvm":{"const":"20.1.1"},"binaryen":{"const":"108"},"binaryenSHA256":{"$ref":"#/$defs/SHA"},"brotli":{"const":"v1.2.1"},"brotliQuality":{"const":11},"brotliWindow":{"const":0},"gzipLevel":{"const":9},"zopfli":{"const":"v0.0.0-20260611111302-2b73a4c8c2e9"},"zopfliIterations":{"const":5},"builderBrotli":{"const":"v1.2.2"},"esbuild":{"const":"v0.28.1"},"chromeSnapshot":{"const":"1688711"},"chromeProduct":{"const":"154.0.8034.0"},"platformArchives":{"type":"object","additionalProperties":false,"properties":{"linux-x64":{"$ref":"#/$defs/SHA"},"windows-x64":{"$ref":"#/$defs/SHA"}},"minProperties":1},"fonts":{"type":"array","maxItems":16,"items":{"$ref":"#/$defs/Ref"}},"cdproto":{"const":"v0.0.0-20260321001828-e3e3800016bc"},"chromedp":{"const":"v0.15.1"},"node":{"const":"26.8.1"}}},
    "Backend": {"enum":["none","webgl2","webgpu","canvas2d"]},
    "CoefficientSet": {"type":"object","additionalProperties":false,"required":["id","backend","scenario","entries","predictionErrorPPM"],"properties":{"id":{"$ref":"#/$defs/ID"},"backend":{"$ref":"#/$defs/Backend"},"scenario":{"$ref":"#/$defs/Scenario"},"entries":{"type":"array","minItems":11,"maxItems":11,"items":{"$ref":"#/$defs/Coefficient"}},"predictionErrorPPM":{"type":["integer","null"],"minimum":0}}}
  }
}
